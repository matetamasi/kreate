% decision rule addNewFeatureAtomToUpperBound(
%     Atom domainAtom,
%     @focus FeatureAtom featureAtom,
%     Feature feature,
%     Classifier valueType,
%     @focus ClassifierAtom valueAtom
% ) <->
%     mayAddFeatureAtom(domainAtom, featureAtom, feature, valueType, valueAtom),
%     may !equals(valueAtom, valueAtom),
%     featureAtomCountBelowUpperBound(domainAtom, feature)
% ==>
