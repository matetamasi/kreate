% .

% @priority(2)
% decision rule reuseExistingValueAtomToUpperBound(
%     Atom domainAtom,
%     @focus FeatureAtom featureAtom,
%     Feature feature,
%     Type valueType,
%     Atom valueAtom
% ) <->
%     mayAddFeatureAtom(domainAtom, featureAtom, feature, valueType, valueAtom),
%     featureAtomCountBelowUpperBound(domainAtom, feature)
% ==>
%     addFeatureAtom(domainAtom, featureAtom, feature, valueType, valueAtom),
%     reused(valueAtom): true
% .

pred atomWithFeatureAtomOfType(Atom atom, Feature feature, FeatureAtom featureAtom) <->
    Atom::of(atom, type),
    typeFeaturing(type, feature),
    FeatureAtom::of(featureAtom, feature),
    FeatureAtom::domain(featureAtom, atom)
.

@priority(4)
@weight(80.0)
decision rule createValuelessFeatureAtomToLowerBound(
    Atom domainAtom,
    @focus FeatureAtom featureAtom,
    Feature feature
) <->
    !FeatureChain(feature), %TODO: does not finish if this line is here!!
    may !equals(featureAtom, featureAtom),
    !isAbstract(feature),
    must Atom::of(domainAtom, type),
    must typeFeaturing(type, feature),
    count {must atomWithFeatureAtomOfType(domainAtom, feature, _)} < lowerBound(feature)

==>
    FeatureAtom::of(featureAtom, feature),
    domain(featureAtom, domainAtom)
.

@priority(99)
decision rule createClassifierAtomAsValue(FeatureAtom featureAtom, Classifier valueType, @focus ClassifierAtom value) <->
    may !value(featureAtom, _),
    may !equals(value, value),
    !isAbstract(valueType),
    FeatureAtom::of(featureAtom, feature),
    featureTyping(feature, valueType)
==>
    ClassifierAtom::of(value, valueType),
    value(featureAtom, value)
.

propagation rule atomOfClassifierAtomOf(ClassifierAtom a, Classifier c) <->
    Atom::of(a, c)
==>
    ClassifierAtom::of(a, c)
.

propagation rule atomOfFeatureAtomOf(FeatureAtom a, Feature f) <->
    Atom::of(a, f)
==>
    FeatureAtom::of(a, f)
.

%% Abstract constraints

pred atomOfNonAbstractSub(ClassifierAtom a, Classifier ac) <->
    isAbstract(ac),
    ClassifierAtom::of(a, ac),
    ClassifierAtom::of(a, c),
    superclass(c, ac),
    !isAbstract(c)
.
error abstractAtomWithoutSpecificType(ClassifierAtom a) <->
    Classifier(ac),
    isAbstract(ac),
    ClassifierAtom::of(a, ac),
    !atomOfNonAbstractSub(a, ac)
.

pred featureAtomOfNonAbstractSub(FeatureAtom fa, Feature af) <->
    isAbstract(af),
    FeatureAtom::of(fa, af),
    FeatureAtom::of(fa, f),
    specializedType(f, af),
    !isAbstract(f)
.
error abstractFeatureAtomWithoutSpecificType(FeatureAtom fa) <->
    Feature(f),
    isAbstract(f),
    FeatureAtom::of(fa, f),
    !featureAtomOfNonAbstractSub(fa, f)
.

%% Feature chaining

pred FeatureChainInstance(FeatureAtom fa) <->
    Atom::of(fa, f),
    FeatureChain(f)
.

@decide(false)
class FeatureChain extends Feature {
    @decide(false)
    Feature [1] first
    @decide(false)
    Feature [1] second
}
!exists(FeatureChain::new).

shadow pred chainExists(FeatureChain fc, Atom a1, Atom a3) <->
    FeatureAtom::of(fa, fc),
    FeatureAtom::domain(fa, a1),
    FeatureAtom::value(fa, a3)
.

error pred duplicateChainInstance(FeatureAtom ci1, FeatureAtom ci2) <->
    FeatureChain(fc),
    FeatureAtom::of(ci1, fc),
    FeatureAtom::domain(ci1, d),
    FeatureAtom::value(ci1, v),
    FeatureAtom::of(ci2, fc),
    FeatureAtom::domain(ci2, d),
    FeatureAtom::value(ci2, v),
    ci1 != ci2
.

pred chainMayExist(Atom a1, Atom a3, FeatureChain fc) <->
    specificFeatureAtom(a1, _, first, a2),
    specificFeatureAtom(a2, _, second, a3),
    FeatureChain::first(fc, first),
    FeatureChain::second(fc, second)
.

@priority(5)
decision rule instantiateChain(FeatureChain fc, @focus FeatureAtom chainInstance, Atom a1, Atom a3) <->
    % must specificFeatureAtom(a1, _, first, a2),
    % must specificFeatureAtom(a2, _, second, a3),
    % must FeatureChain::first(fc, first),
    % must FeatureChain::second(fc, second),
    must chainMayExist(a1, a3, fc),
    may !equals(chainInstance, chainInstance),
    may !chainExists(fc, a1, a3)
==>
    FeatureAtom::of(chainInstance, fc),
    FeatureAtom::domain(chainInstance, a1),
    FeatureAtom::value(chainInstance, a3)
.

error invalidFeatureChain(FeatureChain fc, FeatureAtom chainInstance) <->
    FeatureAtom::of(chainInstance, fc),
    FeatureAtom::domain(chainInstance, a1),
    FeatureAtom::value(chainInstance, a3),
    !chainMayExist(a1, a3, fc)
.
    
    
